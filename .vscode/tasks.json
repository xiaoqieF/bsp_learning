{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate kernel module compile database",
            "type": "shell",
            "command": "${workspaceFolder}/labs/common/generate-compile-commands.sh",
            "options": {
                "cwd": "${workspaceFolder}"
